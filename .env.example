# Copy the variables you need into your environment or hosting provider's
# secret settings. Never commit real values.

# production enables secure cookies, HSTS and request logging
NODE_ENV=development
PORT=3000

# Where the SQLite database and uploaded files live (keep private, back it up)
DATA_DIR=./data

# REQUIRED in production: 32+ random bytes used to sign short-lived download links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_LINK_SECRET=

# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS
TRUST_PROXY=false
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=

# Optional tuning
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=48
DOWNLOAD_LINK_TTL_SECONDS=300
MAX_UPLOAD_MB=10
INVITATION_TTL_DAYS=14
AUTH_RATE_LIMIT=20
LOG_REQUESTS=
