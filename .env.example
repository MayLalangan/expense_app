# Copy to .env for local use (npm scripts load it automatically; .env is
# git-ignored). On Render, set these in the service's Environment settings.
# Never commit real values.

# production enables secure cookies, HSTS, request logs, and requires the
# Supabase settings below
NODE_ENV=development
PORT=3000

# ---- Database ----------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string → "Session pooler"
# (works from Render, which has no IPv6). Leave empty locally to use the
# built-in local Postgres (PGlite) under DATA_DIR/pgdata.
DATABASE_URL=
# Optional but recommended: Supabase's CA certificate (Database settings → SSL
# Configuration → Download certificate). Paste the PEM; "\n" escapes are fine.
# Without it the connection is still encrypted, but the server isn't verified.
DATABASE_CA_CERT=

# ---- File storage (receipts) -------------------------------------------------
# Supabase: Project Settings → API. The service-role key is a secret: it stays
# on the server and is never sent to browsers. Leave empty locally to store
# files under DATA_DIR/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=receipts

# ---- Security ------------------------------------------------------------------
# REQUIRED in production: 32+ random bytes used to sign short-lived download links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_LINK_SECRET=
# true behind a proxy that terminates HTTPS (Render: true)
TRUST_PROXY=false
# Defaults to true when NODE_ENV=production
COOKIE_SECURE=

# Local data folder (PGlite database + uploads when not using Supabase)
DATA_DIR=./data
# Only for a host with a persistent disk: allow production without Supabase
ALLOW_LOCAL_DATA=false

# Optional tuning
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=48
DOWNLOAD_LINK_TTL_SECONDS=300
MAX_UPLOAD_MB=10
INVITATION_TTL_DAYS=14
AUTH_RATE_LIMIT=20
DATABASE_POOL_SIZE=5
LOG_REQUESTS=
